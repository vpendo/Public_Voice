# Environment Configuration Template
# Copy this to .env and fill in your values

# —— Application ——
APP_NAME=PublicVoice
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
# Demo only: include dev_otp in login response when email fails.
ALLOW_DEV_OTP_RESPONSE=false

# —— Database (PostgreSQL only) ——
# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/publicvoice

# —— Security ——
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# —— CORS (Frontend URLs) ——
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://publicvoice1.netlify.app,https://publicvoice.rw,https://www.publicvoice.rw

# —— Email (required for OTP to reach user inbox) ——
# Without these, OTP is only shown on the app screen (dev/fallback). To send OTP to user email, set:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@publicvoice.rw
SMTP_USE_TLS=true
ADMIN_NOTIFY_EMAILS=
# Inbox for /contact form submissions (default: publicvoicerwanda@gmail.com)
CONTACT_INBOX_EMAIL=publicvoicerwanda@gmail.com

# Alternative email variable names (also supported)
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_PASSWORD=
EMAIL_LOGIN=

# —— Frontend URL (for password reset links) ——
FRONTEND_URL=http://localhost:5173
