# Environment Configuration Template
# Copy this to .env and fill in your values

# —— Application ——
APP_NAME=PublicVoice
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# —— Database ——
# SQLite (local dev): sqlite:///./publicvoice.db
# PostgreSQL (production): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./publicvoice.db

# —— Security ——
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# —— CORS (Frontend URLs) ——
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://publicvoice1.netlify.app

# —— AI/NLP: Report translation/structuring (OpenAI) ——
OPENAI_API_KEY=sk-...your-api-key-here...
# OPENAI_API_BASE=https://api.openai.com/v1  # optional, for Azure or custom endpoints
# OPENAI_MODEL=gpt-4o-mini

# —— Email (required for OTP to reach user inbox) ——
# Without these, OTP is only shown on the app screen (dev/fallback). To send OTP to user email, set:
# Gmail: use an App Password (not your normal password). Enable 2FA first, then create App Password at myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
# Outlook/Office365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASSWORD=your-sendgrid-api-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@publicvoice.rw
SMTP_USE_TLS=true
ADMIN_NOTIFY_EMAILS=

# —— Frontend URL (for password reset links) ——
FRONTEND_URL=http://localhost:5173
